{
  "name": "opentutor-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "dev:turbo": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:node": "node ./scripts/run-node-tests.mjs",
    "test:component": "vitest run",
    "test:component:watch": "vitest",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:smoke": "playwright test --project=smoke",
    "check": "npm run lint && npm run typecheck && npm run test:node && npm run test:component",
    "check:e2e": "npm run check && npm run test:smoke && npm run test:visual",
    "perf:check": "node ./scripts/route_budgets.mjs",
    "build:perf": "npm run build && npm run perf:check",
    "i18n:parity": "node ./scripts/i18n_parity.mjs",
    "i18n:audit": "node ./scripts/i18n_audit.mjs",
    "i18n:audit:strict": "node ./scripts/i18n_audit.mjs --strict",
    "i18n:check": "npm run i18n:parity && npm run i18n:audit",
    "audit": "playwright test --project=ui-audit",
    "audit:ui": "playwright test --ui --project=ui-audit",
    "audit:report": "playwright show-report"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "framer-motion": "^12.24.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.14.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  }
}
